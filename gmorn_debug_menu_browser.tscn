[gd_scene format=3]

[node name="Browser" type="VBoxContainer"]
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="Navigation" type="HBoxContainer" parent="."]
layout_mode = 2

[node name="Path" type="RichTextLabel" parent="Navigation"]
layout_mode = 2
size_flags_horizontal = 3
bbcode_enabled = true
text = "[url=]Root[/url]"
fit_content = true
scroll_active = false

[node name="Scroll" type="ScrollContainer" parent="."]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Rows" type="VBoxContainer" parent="Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 12

[node name="Separator" type="HSeparator" parent="."]
layout_mode = 2

[node name="Status" type="Label" parent="."]
layout_mode = 2
autowrap_mode = 3
